<Window x:Class="ScreenCanvas.Capture.CapturePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InkIt Screenshot"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        Width="620" Height="480">
    <Window.Resources>
        <ControlTemplate x:Key="PreviewButtonTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="Transparent"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="3"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="4"
                              Opacity="0.16" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="12,10,12,6">
                <Grid>
                    <TextBlock Text="Screenshot" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="DimensionsText" HorizontalAlignment="Right"
                               VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Grid>
            </Border>

            <!-- Preview image -->
            <Border Grid.Row="1" Margin="10,4" CornerRadius="6"
                    Background="#05000000" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Image x:Name="PreviewImage" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </ScrollViewer>
            </Border>

            <!-- Bottom buttons -->
            <Border Grid.Row="2" Padding="10,8,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Discard and Copy to clipboard -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="DiscardButton"
                                Padding="14,7" Cursor="Hand"
                                Template="{StaticResource PreviewButtonTemplate}"
                                ToolTip="Discard screenshot (Esc)"
                                Click="Discard_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Fluent.Dismiss.Regular}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="0" Margin="0,0,7,0"/>
                                <TextBlock Text="Discard" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CopyButton"
                                Padding="14,7" Cursor="Hand" Margin="6,0,0,0"
                                Template="{StaticResource PreviewButtonTemplate}"
                                ToolTip="Copy to clipboard (Ctrl+C)"
                                Click="Copy_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Fluent.Clipboard.Regular}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="0" Margin="0,0,7,0"/>
                                <TextBlock Text="Copy" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Save buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SavePngButton" Padding="14,7" Cursor="Hand"
                                Template="{StaticResource PreviewButtonTemplate}"
                                ToolTip="Save as PNG"
                                Click="SavePng_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Fluent.ArrowDownload.Regular}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="0" Margin="0,0,7,0"/>
                                <TextBlock Text="PNG" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="SaveJpegButton" Padding="14,7" Cursor="Hand"
                                Margin="6,0,0,0"
                                Template="{StaticResource PreviewButtonTemplate}"
                                ToolTip="Save as JPEG"
                                Click="SaveJpeg_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Fluent.ArrowDownload.Regular}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="0" Margin="0,0,7,0"/>
                                <TextBlock Text="JPEG" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
