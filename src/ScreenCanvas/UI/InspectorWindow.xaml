<Window x:Class="ScreenCanvas.UI.InspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InkIt Inspector"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowActivated="False">
  <!-- Transparent margin leaves room for the shadow-2xl drop shadow. -->
  <Border x:Name="InspectorChrome" Width="288" Margin="24,16,24,32" CornerRadius="16" Padding="16" BorderThickness="1"
          Background="{DynamicResource Ink.Surface}" BorderBrush="{DynamicResource Ink.Border}"
          TextElement.FontFamily="{StaticResource Ink.Font}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.45" Color="#000000" RenderingBias="Performance"/>
    </Border.Effect>
    <DockPanel>
      <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Ink.Divider}" Padding="0,0,0,12" Margin="0,0,0,12">
        <DockPanel>
          <StackPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
          <TextBlock x:Name="HeaderTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink.Text300}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>
      <ContentControl x:Name="Body" Focusable="False"/>
    </DockPanel>
  </Border>
</Window>
