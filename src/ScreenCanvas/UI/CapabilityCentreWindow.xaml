<Window x:Class="ScreenCanvas.UI.CapabilityCentreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capability Centre"
        Width="640" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </Window.Resources>
  <Border Margin="16" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="4" Opacity="0.16" Color="#000000"/>
    </Border.Effect>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/>
        <ColumnDefinition Width="1"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left Category Navigation Rail -->
      <Grid Grid.Column="0" Margin="0,0,8,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="CAPABILITIES" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,4,8,8"/>

        <!-- Categories List -->
        <ListBox x:Name="CategoryList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                 SelectionChanged="CategoryList_OnSelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="8,6"/>
              <Setter Property="Margin" Value="0,1"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Bottom Quick Actions -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
          <Button x:Name="PresetsButton" Content="⚡ Presets Hub" Padding="8,5" Margin="0,2" HorizontalContentAlignment="Left"
                  Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" Click="PresetsButton_OnClick"/>
          <Button x:Name="SettingsButton" Content="⚙ Preferences" Padding="8,5" Margin="0,2" HorizontalContentAlignment="Left"
                  Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" Click="SettingsButton_OnClick"/>
        </StackPanel>
      </Grid>

      <!-- Vertical Divider -->
      <Border Grid.Column="1" Width="1" Background="{DynamicResource SeparatorBrush}"/>

      <!-- Right Content Explorer -->
      <Grid Grid.Column="2" Margin="10,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Grid Grid.Row="0" Margin="4,0,4,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                Fill="{DynamicResource SecondaryTextBrush}" Data="{StaticResource Fluent.Search.Regular}"/>

          <TextBox x:Name="SearchBox" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                   FontSize="13" BorderThickness="0" Background="Transparent"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   CaretBrush="{DynamicResource PrimaryTextBrush}"
                   TextChanged="SearchBox_OnTextChanged"
                   PreviewKeyDown="SearchBox_OnPreviewKeyDown"/>

          <Button Grid.Column="2" Content="✕" Width="24" Height="24" FontSize="11"
                  Foreground="{DynamicResource SecondaryTextBrush}" Background="Transparent"
                  Click="CloseButton_OnClick" ToolTip="Close (Esc)"/>
        </Grid>

        <!-- Tools List / Grid -->
        <ListBox x:Name="ToolsList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 MouseDoubleClick="ToolsList_OnMouseDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Padding="8,6" CornerRadius="6" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="ToolItem_OnMouseLeftButtonUp">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- Icon -->
                  <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                        Fill="{DynamicResource PrimaryTextBrush}" Data="{Binding IconGeometry}"/>

                  <!-- Name & Description -->
                  <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>

                  <!-- Shortcut -->
                  <Border Grid.Column="2" Background="{DynamicResource HoverBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                          Visibility="{Binding HasShortcut, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding Shortcut}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer -->
        <TextBlock Grid.Row="2" x:Name="FooterText" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="4,6,0,0" Text="Select any capability to activate immediately • Esc to close"/>
      </Grid>
    </Grid>
  </Border>
</Window>
