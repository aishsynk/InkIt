<Window x:Class="ScreenCanvas.UI.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radial Quick Menu"
        Width="260" Height="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
  <Window.Resources>
    <Style x:Key="RadialSectorButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Level2Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="RootGrid" Width="260" Height="260">
    <!-- Outer ambient shadow & background ring -->
    <Ellipse Width="240" Height="240" Fill="{DynamicResource PanelBrush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1">
      <Ellipse.Effect>
        <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
      </Ellipse.Effect>
    </Ellipse>

    <!-- Canvas for 8 radial buttons positioned in a circle -->
    <Canvas x:Name="SectorsCanvas" Width="240" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center"/>

    <!-- Center Close / Current indicator -->
    <Button x:Name="CenterButton" Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource Level2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Cursor="Hand" ToolTip="Close Menu (Esc)" Click="CenterButton_OnClick">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="26">
            <Path Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource PrimaryTextBrush}" Data="{StaticResource Fluent.Dismiss.Regular}"/>
          </Border>
        </ControlTemplate>
      </Button.Template>
    </Button>
  </Grid>
</Window>
