<Window x:Class="ScreenCanvas.UI.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenCanvas.UI"
        Title="InkIt"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="7" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="{StaticResource Toolbar.Button}"/>
      <Setter Property="Height" Value="{StaticResource Toolbar.Button}"/>
      <Setter Property="Margin" Value="0,0.5"/>
    </Style>

    <Style x:Key="ToolIcon" TargetType="Path">
      <Setter Property="Width" Value="{StaticResource Toolbar.Icon}"/>
      <Setter Property="Height" Value="{StaticResource Toolbar.Icon}"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="StrokeThickness" Value="0"/>
    </Style>
  </Window.Resources>

  <!-- Toolbar Chrome Strip (32 DIP, 7 DIP radius, subtle border & shadow) -->
  <Border x:Name="ToolbarChrome" HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="7" Padding="3,3"
              PreviewMouseLeftButtonDown="ToolbarChrome_OnPreviewMouseLeftButtonDown">
        <Border.Effect>
          <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.10" Color="#000000"/>
        </Border.Effect>

        <StackPanel x:Name="ToolStack" Orientation="Horizontal">
          <!-- Drag Grip Handle -->
          <Border x:Name="DragGrip" Width="9" Height="20" Margin="1,0,2,0" Background="Transparent"
                  Cursor="SizeAll" ToolTip="Drag to reposition toolbar"
                  PreviewMouseLeftButtonDown="DragGrip_PreviewMouseLeftButtonDown">
            <StackPanel x:Name="DragGripDots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
              <StackPanel Orientation="Vertical" Margin="0.75,0">
                <Ellipse Width="2" Height="2" Fill="{DynamicResource MutedTextBrush}" Margin="0,1" Opacity="0.55"/>
                <Ellipse Width="2" Height="2" Fill="{DynamicResource MutedTextBrush}" Margin="0,1" Opacity="0.55"/>
                <Ellipse Width="2" Height="2" Fill="{DynamicResource MutedTextBrush}" Margin="0,1" Opacity="0.55"/>
              </StackPanel>
              <StackPanel Orientation="Vertical" Margin="0.75,0">
                <Ellipse Width="2" Height="2" Fill="{DynamicResource MutedTextBrush}" Margin="0,1" Opacity="0.55"/>
                <Ellipse Width="2" Height="2" Fill="{DynamicResource MutedTextBrush}" Margin="0,1" Opacity="0.55"/>
                <Ellipse Width="2" Height="2" Fill="{DynamicResource MutedTextBrush}" Margin="0,1" Opacity="0.55"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- InkIt Brand Mark -->
          <Button x:Name="InkitBrandButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="InkIt Presenter Hub"
                  ToolTip="InkIt Presenter Hub&#x0a;Click: Open Capability Centre&#x0a;Drag: Reposition toolbar"
                  PreviewMouseLeftButtonDown="InkitBrandButton_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="InkitBrandButton_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="InkitBrandButton_PreviewMouseLeftButtonUp"
                  Click="InkitBrand_Click">
            <Image Source="/Assets/InkIt.png" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
          </Button>

          <!-- ═══ GROUP: Navigation ═══ -->
          <Border x:Name="Sep0" Width="1" Height="13" VerticalAlignment="Center" Background="{DynamicResource SeparatorBrush}" Margin="2,0,2,0"/>

<!-- Cursor / Select -->
          <Button x:Name="CursorButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="Cursor (Esc)"
                  ToolTip="Cursor (Esc)&#x0a;Return to desktop click-through mode" Click="Cursor_Click">
            <Path x:Name="CursorIcon" Style="{StaticResource ToolIcon}" Data="{StaticResource Fluent.Cursor.Regular}"/>
          </Button>

<Border x:Name="Sep1" Width="1" Height="13" VerticalAlignment="Center" Background="{DynamicResource SeparatorBrush}" Margin="2,0,2,0"/>

<!-- Pen / Draw -->
          <Button x:Name="PenButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="Pen (P)"
                  ToolTip="Pen (P)&#x0a;Freehand drawing — click to choose nib, width &amp; color" Click="Pen_Click">
            <Path x:Name="PenIcon" Style="{StaticResource ToolIcon}" Data="{StaticResource Fluent.Pen.Regular}"/>
          </Button>

<!-- Highlighter -->
          <Button x:Name="HighlighterButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="Highlighter (H)"
                  ToolTip="Highlighter (H)&#x0a;Translucent ink to emphasise text or areas" Click="Highlighter_Click">
            <Path x:Name="HighlighterIcon" Style="{StaticResource ToolIcon}" Data="{StaticResource Fluent.Highlight.Regular}"/>
          </Button>

<!-- Shapes -->
          <Button x:Name="ShapesButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="Shapes (S)"
                  ToolTip="Shapes (S)&#x0a;Arrows, rectangles, connectors, diagrams" Click="Shapes_Click">
            <Path x:Name="ShapesIcon" Style="{StaticResource ToolIcon}" Data="{StaticResource Fluent.Shapes.Regular}"/>
          </Button>

<!-- Text -->
          <Button x:Name="TextButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="Text (T)"
                  ToolTip="Text (T)&#x0a;Type notes directly on screen with font styling" Click="Text_Click">
            <Path x:Name="TextIcon" Style="{StaticResource ToolIcon}" Data="{StaticResource Fluent.Text.Regular}"/>
          </Button>

<!-- Colour Chip -->
          <Button x:Name="ColorChipButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="Colour (C)"
                  ToolTip="Colour (C)&#x0a;Choose from 6 teaching colours" Click="ColorChip_Click">
            <Border x:Name="ColorChipOrb" Width="12" Height="12" CornerRadius="6"
                    Background="#2563EB" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
          </Button>

<Border x:Name="Sep2" Width="1" Height="13" VerticalAlignment="Center" Background="{DynamicResource SeparatorBrush}" Margin="2,0,2,0"/>

<!-- Eraser -->
          <Button x:Name="EraserButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="Eraser (E)"
                  ToolTip="Eraser (E)&#x0a;Remove strokes and shapes by tapping them" Click="Eraser_Click">
            <Path x:Name="EraserIcon" Style="{StaticResource ToolIcon}" Data="{StaticResource Fluent.EraserTool.Regular}"/>
          </Button>

<!-- Undo -->
          <Button x:Name="UndoButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="Undo (Ctrl+Z)"
                  ToolTip="Undo (Ctrl+Z)&#x0a;Revert last drawn stroke or shape" Click="Undo_Click">
            <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Fluent.ArrowUndo.Regular}"/>
          </Button>

<!-- Redo -->
          <Button x:Name="RedoButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="Redo (Ctrl+Y)"
                  ToolTip="Redo (Ctrl+Y)&#x0a;Reapply previously undone action" Click="Redo_Click">
            <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Fluent.ArrowRedo.Regular}"/>
          </Button>

<!-- Clear All -->
          <Button x:Name="ClearButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="Clear All (Ctrl+Shift+Del)"
                  ToolTip="Clear All (Ctrl+Shift+Del)&#x0a;Erase every annotation on screen" Click="Clear_Click">
            <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Fluent.Dismiss.Regular}"/>
          </Button>

<Border x:Name="Sep3" Width="1" Height="13" VerticalAlignment="Center" Background="{DynamicResource SeparatorBrush}" Margin="2,0,2,0"/>

<!-- Present / Laser -->
          <Button x:Name="PresentButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="Present (L)"
                  ToolTip="Present (L)&#x0a;Laser pointer and code focus band" Click="Present_Click">
            <Path x:Name="PresentIcon" Style="{StaticResource ToolIcon}" Data="{StaticResource Fluent.Laser.Regular}"/>
          </Button>

<!-- Spotlight -->
          <Button x:Name="SpotlightButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="Spotlight (M)"
                  ToolTip="Spotlight (M)&#x0a;Dim screen with circular focus around cursor" Click="Spotlight_Click">
            <Path x:Name="SpotlightIcon" Style="{StaticResource ToolIcon}" Data="{StaticResource Fluent.Circle.Regular}"/>
          </Button>

<!-- Zoom -->
          <Button x:Name="ZoomButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="Zoom (Z)"
                  ToolTip="Zoom (Z)&#x0a;Magnify screen — click again to freeze &amp; inspect" Click="Zoom_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Path x:Name="ZoomIcon" Style="{StaticResource ToolIcon}" Data="{StaticResource Fluent.ZoomIn.Regular}"/>
              <TextBlock x:Name="ZoomLevelText" Grid.Column="1"
                         FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}"
                         VerticalAlignment="Center" Margin="2,0,0,0"
                         Text="100%" Visibility="Collapsed"/>
            </Grid>
          </Button>

<Border x:Name="Sep4" Width="1" Height="13" VerticalAlignment="Center" Background="{DynamicResource SeparatorBrush}" Margin="2,0,2,0"/>

<!-- Capture Screenshot (NEW) -->
          <Button x:Name="CaptureButton" Style="{StaticResource ToolButton}"
                    AutomationProperties.Name="Screenshot (PrintScreen)"
                    ToolTip="Screenshot (PrintScreen)&#x0a;Select a region to capture&#x0a;Preview, save as PNG/JPEG, or copy to clipboard" Click="Capture_Click">
            <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Fluent.Camera.Regular}"/>
          </Button>



<Border x:Name="Sep5" Width="1" Height="13" VerticalAlignment="Center" Background="{DynamicResource SeparatorBrush}" Margin="2,0,2,0"/>

<!-- More / Capabilities -->
          <Button x:Name="MoreButton" Style="{StaticResource ToolButton}"
                  AutomationProperties.Name="More"
                  ToolTip="More (&#x2026;)&#x0a;Boards, timer, settings, all capabilities" Click="More_Click">
            <Path x:Name="MoreIcon" Style="{StaticResource ToolIcon}" Data="{StaticResource Fluent.MoreVertical.Regular}"/>
          </Button>

<!-- Collapse -->
          <Button x:Name="CollapseButton" Style="{StaticResource ToolButton}" Width="18" Height="23"
                  AutomationProperties.Name="Collapse toolbar"
                  ToolTip="Collapse toolbar to minimal tile" Click="Collapse_Click">
            <Path x:Name="CollapseChevron" Width="9" Height="9" Stretch="Uniform"
                  Fill="{DynamicResource SecondaryTextBrush}" Data="{StaticResource Fluent.ChevronDown.Regular}"/>
          </Button>
        </StackPanel>
      </Border>
</Window>
