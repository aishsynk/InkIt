<Window x:Class="ScreenCanvas.UI.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InkIt"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">
  <!-- The transparent margin leaves room for the design's shadow-2xl. -->
  <Border x:Name="ToolbarChrome" Margin="20,12,20,28" CornerRadius="16" BorderThickness="1"
          HorizontalAlignment="Left" VerticalAlignment="Top"
          Background="{DynamicResource Ink.Surface}" BorderBrush="{DynamicResource Ink.Border}"
          TextElement.FontFamily="{StaticResource Ink.Font}">
    <Border.Effect>
      <DropShadowEffect x:Name="ChromeShadow" BlurRadius="36" ShadowDepth="12" Direction="270" Opacity="0.5" Color="#000000" RenderingBias="Performance"/>
    </Border.Effect>
    <StackPanel x:Name="ChromeStack">
      <StackPanel x:Name="Strip" Orientation="Horizontal" Margin="6"/>
      <Border x:Name="Footer" BorderThickness="0,1,0,0" CornerRadius="0,0,15,15" Padding="8,2,8,3"
              Background="{DynamicResource Ink.Footer}" BorderBrush="{DynamicResource Ink.Divider}"/>
    </StackPanel>
  </Border>
</Window>
