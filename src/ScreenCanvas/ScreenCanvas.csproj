<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InkIt</AssemblyName>
    <RootNamespace>ScreenCanvas</RootNamespace>
    <Product>InkIt</Product>
    <Title>InkIt</Title>
    <Description>InkIt — Professional Screen Annotation &amp; Presentation Tool</Description>
    <!-- Stamped by tools/release/Release.ps1 from version.txt (0.0.0.N, +1 per release). -->
    <Version>0.0.0.0</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>InkIt</Company>
    <Authors>Aishwar Nigam</Authors>
    <Copyright>Copyright (c) 2026 Aishwar Nigam</Copyright>
    <ApplicationIcon>Assets\InkIt.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\InkIt.png" />
    <Resource Include="Assets\InkIt.ico" />
    <Resource Include="Assets\InkItLogo.png" />
    <Resource Include="Assets\InkItLogoWhite.png" />
    <Resource Include="Assets\InkItMark.png" />
    <Resource Include="Assets\InkItMarkWhite.png" />
    <Resource Include="Assets\InkItMarkDark.png" />
  </ItemGroup>
</Project>
